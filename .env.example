# Copy to .env and fill in what you need. Everything is optional.

# AI tutor: a free NVIDIA API key from https://build.nvidia.com (API Keys -> Generate API Key).
# You can also paste the key in the app instead: Teacher console -> AI settings.
# Without a key, TatvaX runs in "notes mode" (answers come from the study notes).
NVIDIA_API_KEY=
# TATVAX_MODEL=nvidia/nemotron-3-super-120b-a12b   # any chat model ID from build.nvidia.com
# TATVAX_AI=off                        # turn the AI tutor off completely

# Security
# TATVAX_SECRET_KEY=               # default: generated and stored in instance/secret_key
# TATVAX_TEACHER_CODE=             # code staff enter to create teacher accounts
# TATVAX_SECURE_COOKIES=1          # set when serving over HTTPS
# TATVAX_BEHIND_PROXY=1            # set behind nginx / a load balancer

# Storage and server
# TATVAX_DATABASE=instance/tatvax.db
# TATVAX_HOST=127.0.0.1
# TATVAX_PORT=5000
# TATVAX_CHAT_RATE_LIMIT=20        # questions per minute per learner
# TATVAX_UTC_OFFSET_MINUTES=330    # school time zone for streaks and due dates (330 = India)
# TATVAX_SHARED_RATE_LIMIT=1       # keep rate limits in the database when running several worker processes
